{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k2a.example/schemas/tappa3/bt_residenziale.schema.json",
  "title": "Schema BT Residenziale - Tappa 3 Fase 1",
  "version": "1.0",
  "description": "Schema dati 'Medio Plus' per l'asseverazione di una cabina di trasformazione MT/BT industriale. Ogni campo dato e' un oggetto con stato esplicito (DICHIARATO/DEFAULT/RICHIESTO), cosi' che il professionista veda cosa e' stato dichiarato dall'utente, cosa assunto dall'orchestrator e cosa manca. Sezioni A-E. I valori numerici ingegneristici NON sono prodotti da LLM (vedi DESIGN_TAPPA3_FASE1.md sez.8.2).",
  "type": "object",
  "$defs": {
    "StatoCampo": {
      "title": "StatoCampo",
      "type": "string",
      "enum": [
        "DICHIARATO",
        "DEFAULT",
        "RICHIESTO"
      ],
      "description": "DICHIARATO = fornito dall'utente; DEFAULT = assunto dall'orchestrator (review richiesta); RICHIESTO = necessario ma mancante (blocca la firma)."
    },
    "Fonte": {
      "title": "Fonte",
      "type": "string",
      "enum": [
        "utente",
        "default_tipologico",
        "geocoding_automatico",
        "norma",
        "calcolo"
      ],
      "description": "Provenienza del valore del campo."
    },
    "CampoBase": {
      "title": "CampoBase",
      "type": "object",
      "description": "Wrapper standard di ogni campo dato con stato esplicito.",
      "properties": {
        "valore": {
          "description": "Il valore del campo (tipo specifico per ciascun campo)."
        },
        "stato": {
          "$ref": "#/$defs/StatoCampo"
        },
        "fonte": {
          "$ref": "#/$defs/Fonte"
        },
        "norma_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Riferimento normativo quando il valore (tipicamente DEFAULT) discende da una norma. Es. 'CEI 64-8 art.525'.",
          "default": null
        },
        "review_richiesta": {
          "type": "boolean",
          "description": "True per ogni campo DEFAULT o RICHIESTO: il professionista deve revisionarlo prima della firma.",
          "default": false
        }
      },
      "required": [
        "valore",
        "stato",
        "fonte",
        "review_richiesta"
      ],
      "additionalProperties": false
    },
    "Coordinata": {
      "title": "Coordinata",
      "type": "object",
      "description": "Coordinate geografiche WGS84 (decimal degrees).",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "examples": [
            42.7395
          ]
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "examples": [
            12.7388
          ]
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "additionalProperties": false
    },
    "Sorgente": {
      "title": "Sorgente",
      "type": "object",
      "description": "Sorgente di alimentazione generica (rete, gruppo elettrogeno, FV, BESS).",
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "rete_dso",
            "gruppo_elettrogeno",
            "fotovoltaico",
            "bess",
            "ups"
          ]
        },
        "potenza_kVA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Potenza apparente nominale [kVA] (o kW per FV)."
        },
        "tensione_V": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lato_connessione": {
          "type": "string",
          "enum": [
            "MT",
            "BT"
          ],
          "description": "Lato di connessione della sorgente."
        },
        "ats": {
          "type": "boolean",
          "description": "Presenza di commutatore automatico (ATS) per la sorgente.",
          "default": false
        }
      },
      "required": [
        "tipo",
        "potenza_kVA",
        "lato_connessione"
      ],
      "additionalProperties": true
    },
    "Trasformatore": {
      "title": "Trasformatore",
      "type": "object",
      "description": "Trasformatore MT/BT (CEI EN 60076).",
      "properties": {
        "Sn_kVA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "examples": [
            1000
          ]
        },
        "V1_kV": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Tensione primaria (MT) [kV].",
          "examples": [
            15
          ]
        },
        "V2_V": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Tensione secondaria (BT) [V].",
          "examples": [
            400
          ]
        },
        "vcc_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "description": "Tensione di cortocircuito [%].",
          "examples": [
            6.0
          ]
        },
        "gruppo": {
          "type": "string",
          "description": "Gruppo vettoriale.",
          "examples": [
            "Dyn11"
          ]
        },
        "raffreddamento": {
          "type": "string",
          "enum": [
            "ONAN",
            "AN",
            "AF",
            "altro"
          ],
          "default": "ONAN"
        }
      },
      "required": [
        "Sn_kVA",
        "V1_kV",
        "V2_V",
        "vcc_pct"
      ],
      "additionalProperties": true
    },
    "LineaElettrica": {
      "title": "LineaElettrica",
      "type": "object",
      "description": "Linea/conduttura elettrica (per dimensionamento e caduta di tensione).",
      "properties": {
        "id": {
          "type": "string"
        },
        "tratto": {
          "type": "string",
          "description": "Es. 'trafo->QGBT'."
        },
        "lunghezza_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sezione_mm2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "posa": {
          "type": "string",
          "description": "Tipo di posa (rif. CEI-UNEL 35024)."
        },
        "isolante": {
          "type": "string",
          "enum": [
            "PVC",
            "EPR",
            "XLPE"
          ],
          "default": "EPR"
        }
      },
      "required": [
        "tratto",
        "lunghezza_m"
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "_meta_esempio": {
      "type": "object",
      "description": "Opzionale: metadati documentali di un'istanza di esempio (input naturale, note). Ignorato in produzione.",
      "additionalProperties": true
    },
    "_metadata": {
      "type": "object",
      "description": "Opzionale: metadati prodotti dal Layer 1 classifier (confidence, note).",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "schema_version": {
      "const": "1.0"
    },
    "tipologia": {
      "const": "cantiere_temporaneo",
      "description": "Tipologia (Layer 1)."
    },
    "A_anagrafica_contesto": {
      "type": "object",
      "title": "A - Anagrafica e contesto",
      "description": "Committente, ubicazione, contesto sito (geocoding, sismica, fulminazione, edificio).",
      "properties": {
        "committente": {
          "$ref": "#/$defs/CampoBase",
          "description": "Ragione sociale del committente."
        },
        "piva": {
          "$ref": "#/$defs/CampoBase",
          "description": "Partita IVA / codice fiscale."
        },
        "indirizzo": {
          "$ref": "#/$defs/CampoBase",
          "description": "Indirizzo completo del sito."
        },
        "comune": {
          "$ref": "#/$defs/CampoBase"
        },
        "provincia": {
          "$ref": "#/$defs/CampoBase"
        },
        "coordinate": {
          "allOf": [
            {
              "$ref": "#/$defs/CampoBase"
            }
          ],
          "description": "valore = oggetto Coordinata; fonte tipica geocoding_automatico."
        },
        "zona_sismica": {
          "$ref": "#/$defs/CampoBase",
          "description": "Zona sismica (1-4) o ag/g; norma_ref NTC 2018."
        },
        "Ng_fulmini_km2_anno": {
          "$ref": "#/$defs/CampoBase",
          "description": "Densita' di fulminazione al suolo [1/km2/anno]; norma_ref CEI EN 62305-2."
        },
        "edificio": {
          "type": "object",
          "description": "Dati dell'edificio servito.",
          "properties": {
            "superficie_m2": {
              "$ref": "#/$defs/CampoBase"
            },
            "altezza_interna_m": {
              "$ref": "#/$defs/CampoBase"
            },
            "struttura": {
              "$ref": "#/$defs/CampoBase",
              "description": "Es. metallica, c.a., muratura."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "committente",
        "indirizzo",
        "coordinate"
      ],
      "additionalProperties": false
    },
    "B_allacciamento_sistema": {
      "type": "object",
      "title": "B - Allacciamento e sistema",
      "description": "Punto di consegna MT, stato del neutro, Icc fornita dal DSO, sistema di distribuzione.",
      "properties": {
        "tensione_MT_kV": {
          "$ref": "#/$defs/CampoBase",
          "examples": [
            15
          ]
        },
        "stato_neutro_MT": {
          "$ref": "#/$defs/CampoBase",
          "description": "valore in {isolato, compensato, a_terra}; norma_ref CEI 0-16."
        },
        "Icc_MT_kA": {
          "$ref": "#/$defs/CampoBase",
          "description": "Corrente di cortocircuito MT comunicata dal DSO [kA]; norma_ref CEI 0-16 §5.2.1.3."
        },
        "sistema_distribuzione_BT": {
          "$ref": "#/$defs/CampoBase",
          "description": "valore in {TT, TN-S, TN-C, TN-C-S, IT}; norma_ref CEI 64-8 art.312."
        },
        "potenza_disponibile_kW": {
          "$ref": "#/$defs/CampoBase"
        }
      },
      "required": [
        "tensione_MT_kV",
        "sistema_distribuzione_BT"
      ],
      "additionalProperties": false
    },
    "C_sorgenti_carichi": {
      "type": "object",
      "title": "C - Sorgenti e carichi",
      "description": "Trasformatore/i, sorgenti accessorie (FV, GE, BESS), carico stimato, rifasamento.",
      "properties": {
        "trasformatori": {
          "type": "array",
          "description": "Lista trasformatori MT/BT. valore di CampoBase = array di Trasformatore.",
          "items": {
            "$ref": "#/$defs/CampoBase"
          }
        },
        "sorgenti_accessorie": {
          "type": "array",
          "description": "FV, gruppo elettrogeno, BESS, UPS. valore = oggetto Sorgente.",
          "items": {
            "$ref": "#/$defs/CampoBase"
          }
        },
        "carico": {
          "type": "object",
          "properties": {
            "P_kW": {
              "$ref": "#/$defs/CampoBase"
            },
            "cosphi": {
              "$ref": "#/$defs/CampoBase",
              "description": "Fattore di potenza dichiarato."
            },
            "contemporaneita": {
              "$ref": "#/$defs/CampoBase",
              "description": "Coefficiente di contemporaneita' (DEFAULT tipologico se non dichiarato)."
            }
          },
          "required": [
            "P_kW",
            "cosphi"
          ],
          "additionalProperties": false
        },
        "rifasamento_cosphi_target": {
          "$ref": "#/$defs/CampoBase",
          "description": "cosphi obiettivo dopo rifasamento; norma_ref CEI 0-16 (penali DSO)."
        }
      },
      "required": [
        "carico"
      ],
      "additionalProperties": false
    },
    "D_impianti_protezioni": {
      "type": "object",
      "title": "D - Impianti e protezioni",
      "description": "Impianto di terra, SPD, SPI (se FV), quadri, criteri di selettivita'.",
      "properties": {
        "impianto_terra": {
          "type": "object",
          "properties": {
            "tipo_dispersore": {
              "$ref": "#/$defs/CampoBase",
              "description": "Es. anello, picchetti, magliato; norma_ref CEI 64-12."
            },
            "resistivita_terreno_ohm_m": {
              "$ref": "#/$defs/CampoBase"
            },
            "Re_target_ohm": {
              "$ref": "#/$defs/CampoBase",
              "description": "Resistenza di terra obiettivo; norma_ref CEI 64-8 art.411."
            }
          },
          "additionalProperties": false
        },
        "spd": {
          "$ref": "#/$defs/CampoBase",
          "description": "Presenza/tipo SPD; norma_ref CEI 81-30 / CEI EN 62305."
        },
        "spi": {
          "$ref": "#/$defs/CampoBase",
          "description": "Sistema di protezione di interfaccia (se sorgente FV in parallelo rete); norma_ref CEI 0-21/0-16."
        },
        "criterio_selettivita": {
          "$ref": "#/$defs/CampoBase",
          "description": "Cronometrica/amperometrica/ZSI; norma_ref CEI 0-16 §8.5, CEI 64-8 §536."
        }
      },
      "required": [
        "impianto_terra"
      ],
      "additionalProperties": false
    },
    "E_verifiche_asseverazione": {
      "type": "object",
      "title": "E - Verifiche richieste e asseverazione",
      "description": "Verifiche da eseguire tramite i tool MCP e metadati di asseverazione.",
      "properties": {
        "verifiche_richieste": {
          "type": "array",
          "description": "Elenco delle verifiche (mappate ai tool MCP del Layer 3).",
          "items": {
            "type": "object",
            "properties": {
              "verifica": {
                "type": "string",
                "examples": [
                  "dimensionamento_trafo",
                  "icc_bt_multisorgente",
                  "selettivita",
                  "terra"
                ]
              },
              "tool_mcp": {
                "type": "string",
                "examples": [
                  "dimensiona_trafo",
                  "icc_bt_multisorgente"
                ]
              },
              "obbligatoria": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "verifica",
              "tool_mcp"
            ],
            "additionalProperties": false
          }
        },
        "asseverazione": {
          "type": "object",
          "properties": {
            "firmata": {
              "type": "boolean",
              "const": false,
              "description": "Sempre false alla generazione: la firma e' atto del professionista dopo review (DESIGN sez.8.3)."
            },
            "modalita": {
              "type": "string",
              "const": "validation",
              "description": "Modalita' default: ogni DEFAULT/RICHIESTO va revisionato."
            },
            "professionista": {
              "$ref": "#/$defs/CampoBase"
            }
          },
          "required": [
            "firmata",
            "modalita"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "verifiche_richieste",
        "asseverazione"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tipologia",
    "A_anagrafica_contesto",
    "B_allacciamento_sistema",
    "C_sorgenti_carichi",
    "D_impianti_protezioni",
    "E_verifiche_asseverazione"
  ],
  "additionalProperties": false
}
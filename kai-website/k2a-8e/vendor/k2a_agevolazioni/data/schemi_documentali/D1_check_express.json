    {
      "ordine": 2,
      "titolo": "LE 3 COSE DA SAPERE",
      "pagine": 1,
      "elementi_obbligatori": [
        "box criticità (1 titolo + 2-3 righe + 1 numero in evidenza)",
        "box opportunità (stessa struttura)",
        "box prossimo passo (stessa struttura)",
        "CTA upgrade verso Boost D4"
      ]
    },
    {
      "ordine": 3,
      "titolo": "DATI INPUT + FONTI",
      "pagine": 1,
      "opzionale": true,
      "elementi_obbligatori": [
        "tabella input ricevuti dal cliente",
        "fonti utilizzate citate puntualmente",
        "disclaimer professionale",
        "firma machine-readable motore MCP"
      ]
    }
  ],
  "tono": "diretto, grafico prevalente su prosa, leggibile in 90 secondi",
  "test_qualita": [
    "pagine totali tra 2 e 3",
    "score 0-100 presente in pag 1",
    "almeno 5 semafori KPI",
    "presenza firma machine-readable",
    "presenza CTA upgrade"
  ]

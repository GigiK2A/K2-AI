{
  "$schema": "k2ai-schema-documentale-v1",
  "livello": "D1",
  "nome": "Check Express / Pagella",
  "fascia_prezzo_tipica_eur": [49, 79],
  "pagine_min": 2,
  "pagine_max": 3,
  "pagine_target": 3,
  "indice_id": "A",
  "masterplan_ref": "v2.0 §4.1",
  "sezioni": [
    {
      "ordine": 1,
      "titolo": "COPERTINA + ESITO IMMEDIATO",
      "pagine": 1,
      "elementi_obbligatori": [
        "header K2-AI con logo",
        "nome cliente",
        "data generazione",
        "ID documento univoco",

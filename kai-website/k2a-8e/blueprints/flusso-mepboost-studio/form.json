{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MEPBoost — form input",
  "type": "object",
  "required": ["tipologia_edificio", "superficie_mq", "comune"],
  "properties": {
    "tipologia_edificio": { "type": "string", "description": "tipologia (residenziale, uffici, commerciale, industriale, ricettivo)" },
    "superficie_mq": { "type": "number", "minimum": 0 },
    "comune": { "type": "string", "description": "comune (per zona climatica e gradi-giorno)" },
    "classe_energetica_attuale": { "type": ["string", "null"], "description": "classe APE attuale se nota" },
    "impianto_elettrico": {
      "type": "object",
      "properties": {
        "anno": { "type": ["integer", "null"] },
        "dichiarazione_conformita": { "type": ["boolean", "null"], "description": "presenza DdC (DM 37/2008)" }
      }
    },
    "impianto_termico": {
      "type": "object",
      "properties": {
        "generatore_tipo": { "type": ["string", "null"], "description": "caldaia/pompa di calore/ibrido" },
        "generatore_anno": { "type": ["integer", "null"] }
      }
    },
    "consumi_annui": {
      "type": "object",
      "properties": {
        "elettrico_kwh": { "type": ["number", "null"] },
        "gas_smc": { "type": ["number", "null"] },
        "costo_annuo_eur": { "type": ["number", "null"] }
      }
    },
    "prezzo_energia_eur_kwh": { "type": ["number", "null"], "description": "prezzo €/kWh per derivare il risparmio €/anno degli EEM dai kWh (se noto)" },
    "impianto_elettrico_dettaglio": {
      "type": ["object", "null"],
      "description": "FEED opzionale per audit_elettrico deterministico (k2a_elettrico): se valorizzato, caduta tensione + verifica terra sono calcolate dal MCP (CEI 64-8); altrimenti audit_elettrico resta non valutabile",
      "properties": {
        "sistema_terra": { "type": ["string", "null"], "enum": ["TT", "TN-S", "TN-C", "TN-C-S", null] },
        "RA_ohm": { "type": ["number", "null"], "description": "resistenza dispersore di terra (Ω)" },
        "Idn_RCD_mA": { "type": ["number", "null"], "description": "corrente differenziale RCD (mA)" },
        "circuiti": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nome": { "type": "string" },
              "corrente_a": { "type": "number", "minimum": 0 },
              "lunghezza_m": { "type": "number", "minimum": 0 },
              "sezione_mm2": { "type": "number", "minimum": 0 },
              "sistema": { "type": ["string", "null"], "enum": ["trifase", "monofase", null] },
              "tensione_v": { "type": ["number", "null"] },
              "cosfi": { "type": ["number", "null"] }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

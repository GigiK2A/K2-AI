{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategyBoost — form input PMI",
  "type": "object",
  "required": ["descrizione_azienda", "competitor", "obiettivo_strategico"],
  "properties": {
    "descrizione_azienda": { "type": "string", "description": "settore, prodotti/servizi, clienti target, anno fondazione, dipendenti, fatturato" },
    "settore_ateco": { "type": "string" },
    "competitor": {
      "type": "array",
      "minItems": 1,
      "description": "2-3 competitor principali",
      "items": {
        "type": "object",
        "required": ["nome"],
        "properties": {
          "nome": { "type": "string" },
          "descrizione": { "type": "string" }
        }
      }
    },
    "obiettivo_strategico": { "type": "string", "description": "cosa vuole ottenere nei prossimi 1-3 anni" },
    "risorse_distintive": { "type": "array", "items": { "type": "string" }, "description": "brevetti, know-how, relazioni, brand, localizzazione, velocita" },
    "area_geografica": { "type": "string", "enum": ["locale", "regionale", "nazionale", "export"] },
    "problemi_percepiti": { "type": "string" }
  },
  "additionalProperties": false
}

{
  "functions": {
    "api/report/pdf.ts": { "maxDuration": 60 },
    "api/report/docx.ts": { "maxDuration": 30 },
    "api/kbot/generate-pdf.ts": { "maxDuration": 60 },
    "api/**/*.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/kbot/cleanup",
      "schedule": "0 2 * * 0"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "k2-ai.it"
        }
      ],
      "destination": "https://www.k2-ai.it/$1",
      "permanent": true
    },
    {
      "source": "/casi-studio.html",
      "destination": "/laboratorio.html",
      "permanent": true
    },
    {
      "source": "/workshop.html",
      "destination": "/suite-ai.html",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/suite-ai/services", "destination": "/api/suite-ai/services" },
    { "source": "/suite-ai/services/:id", "destination": "/api/suite-ai/services/:id" },
    { "source": "/kbot/session", "destination": "/api/kbot/session" },
    { "source": "/kbot/message", "destination": "/api/kbot/message" },
    { "source": "/kbot/report", "destination": "/api/kbot/report" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://api.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://*.stripe.com; media-src 'self'; connect-src 'self' https://api.k2-ai.it https://*.stripe.com https://checkout.stripe.com; frame-src https://*.stripe.com https://checkout.stripe.com; form-action 'self' https://*.stripe.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

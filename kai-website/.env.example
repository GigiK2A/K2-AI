VITE_KAI_API_BASE_URL=http://localhost:8000

# PostHog Cloud EU — anonymous tracking, no cookies. Lascia vuoto per disabilitare.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Monitoring & alerting ────────────────────────────
# Optional: Sentry DSN — when set, server-side exceptions are captured.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_ENV=production
APP_RELEASE=kai-website@local

# Log format: "json" (default in prod) or "pretty" (dev). Level: debug|info|warn|error.
LOG_FORMAT=json
LOG_LEVEL=info

# Internal alerting webhook /api/admin/alert — fans out to:
SLACK_ALERTS_WEBHOOK=
# Reuses TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID for Telegram alerts.

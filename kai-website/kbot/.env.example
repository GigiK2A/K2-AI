# Lasciare vuoto in produzione per usare lo stesso dominio e il proxy /api del sito.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://...supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
# Compatibilita' retroattiva:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Produzione consigliata:
# NEXT_PUBLIC_API_BASE_URL=https://api.k2-ai.it
# FRONTEND_URL e REPORT_PAYMENT_LINK sono variabili backend: vedi backend/.env.example.

# PostHog Cloud EU — anonymous (no cookies). Lascia vuoto per disabilitare.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# DEMO MODE — la CTA del report PDF genera SEMPRE in modo gratuito (test_mode,
# nessun checkout Stripe), anche per utenti gia paganti. La label diventa
# "Genera il report PDF (demo)". Per mostrare il prodotto ai clienti.
# Default 0 (produzione: paywall invariato). NB: NEXT_PUBLIC_* e inlinato a
# build-time → dopo averlo messo a 1 serve "npm run build" / restart dev.
NEXT_PUBLIC_KBOT_DEMO_MODE=0

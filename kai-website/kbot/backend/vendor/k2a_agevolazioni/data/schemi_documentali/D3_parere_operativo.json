{
  "$schema": "k2ai-schema-documentale-v1",
  "livello": "D3",
  "nome": "Parere Operativo / Dashboard",
  "fascia_prezzo_tipica_eur": [400, 600],
  "pagine_min": 10,
  "pagine_max": 12,
  "pagine_target": 11,
  "indice_id": "C",
  "masterplan_ref": "v2.0 §4.3",
  "servizi_che_lo_usano_nel_catalogo": ["primo_parere_legale", "revenue_management_hospitality", "revenue_management_hospitality_self", "linea_a_retainer"],
  "sezioni": [
    {"ordine": 1, "titolo": "Copertina + Esito + Indice", "pagine": 1},
    {"ordine": 2, "titolo": "Contesto e quesito + limiti dichiarati", "pagine": 1},
    {
      "ordine": 3,
      "titolo": "Quadro normativo / metodologico con citazioni puntuali",
      "pagine": 2,
      "vincolo_critico": "Tutte le citazioni normative DEVONO provenire da chiamate a normattiva o norme-tecniche. Niente citazioni inventate. Anti-pattern §12.2 MASTERPLAN."
    },
    {
      "ordine": 4,
      "titolo": "Analisi approfondita",
      "pagine": 3,
      "elementi_obbligatori": ["3-5 paragrafi tematici", "ogni paragrafo: dato + interpretazione + implicazione", "tabelle e grafici di supporto"]
    },
    {
      "ordine": 5,
      "titolo": "Raccomandazione operativa",
      "pagine": 2,
      "elementi_obbligatori": ["scelta consigliata con motivazione 3-5 righe", "alternative considerate e perché scartate", "rischi residui"]
    },
    {
      "ordine": 6,
      "titolo": "Piano d'azione",
      "pagine": 1,
      "elementi_obbligatori": ["step operativi numerati", "documenti necessari", "tempi e costi"]
    },
    {
      "ordine": 7,
      "titolo": "Metodologia e fonti",
      "pagine": 1,
      "elementi_obbligatori": ["riferimenti normativi completi", "versione motore MCP", "disclaimer professionale", "firma machine-readable"]
    },
    {"ordine": 8, "titolo": "Appendice tabelle/calcoli", "pagine": 1, "opzionale": true}
  ],
  "tono": "tecnico-professionale, citazioni dense, struttura argomentativa",
  "test_qualita": [
    "pagine totali tra 10 e 12",
    "presenza citazioni normative da fonti MCP (no inventate)",
    "raccomandazione operativa esplicita con motivazione",
    "alternative considerate e scartate",
    "presenza firma machine-readable"
  ]
}

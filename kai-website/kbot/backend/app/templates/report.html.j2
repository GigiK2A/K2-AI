<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <title>{{ meta.title }}</title>
  <style>{{ css | safe }}</style>
</head>
<body>
<div class="page-shell">

  {# ============= BANNER ============= #}
  <header class="report-banner">
    <div class="banner-left">
      {% if logo %}
      <img src="{{ logo }}" alt="K2-AI" class="banner-logo-img">
      {% else %}
      <div class="banner-logo">K2</div>
      {% endif %}
      <div class="banner-title-block">
        <div class="banner-kicker">{{ meta.kicker or 'Report Premium' }}</div>
        <div class="banner-title">{{ meta.title }}</div>
      </div>
    </div>
    <div class="banner-meta">
      {% for line in meta.client_meta_lines or [] %}
      <div>{{ line }}</div>
      {% endfor %}
    </div>
  </header>
  <div class="banner-stripe"></div>

  {# ============= BODY (blocks loop) ============= #}
  <main class="report-body">
    {% for block in blocks %}
      {% set tp = block.type %}
      {% if tp == 'executive_summary' %}
        {% include 'blocks/executive_summary.html.j2' %}
      {% elif tp == 'kpi_grid' %}
        {% include 'blocks/kpi_grid.html.j2' %}
      {% elif tp == 'two_column' %}
        {% include 'blocks/two_column.html.j2' %}
      {% elif tp == 'narrative_split' %}
        {% include 'blocks/narrative_split.html.j2' %}
      {% elif tp == 'data_table' %}
        {% include 'blocks/data_table.html.j2' %}
      {% elif tp == 'action_list' %}
        {% include 'blocks/action_list.html.j2' %}
      {% elif tp == 'risk_mitigation' %}
        {% include 'blocks/risk_mitigation.html.j2' %}
      {% elif tp == 'conclusions' %}
        {% include 'blocks/conclusions.html.j2' %}
      {% elif tp == 'narrative' %}
        {% include 'blocks/narrative.html.j2' %}
      {% endif %}
    {% endfor %}
  </main>

  {# ============= FOOTER ============= #}
  <footer class="report-footer">
    {% if logo %}
    <img src="{{ logo }}" alt="K2-AI" class="footer-logo-img">
    {% else %}
    <div class="footer-logo">K2</div>
    {% endif %}
    <div class="footer-meta">
      <div>{{ footer.line1 or 'Report generato da K2-AI · Dati forniti dall\'utente · Stime basate su skill verticali e dati di mercato pubblici' }}</div>
      <div class="footer-row">
        <a href="https://www.k2-ai.it">k2-ai.it</a>
        <span>·</span>
        <a href="mailto:info@k2-ai.it">info@k2-ai.it</a>
        {% if footer.code %}<span>·</span><span>{{ footer.code }}</span>{% endif %}
      </div>
    </div>
  </footer>

</div>
</body>
</html>

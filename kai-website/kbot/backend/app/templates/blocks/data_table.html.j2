<section class="block-card">
  <div class="block-title">{{ block.title }}</div>
  {% if block.intro %}<div class="block-intro">{{ block.intro }}</div>{% endif %}
  <table class="data-table">
    <thead><tr>{% for c in block.columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for row in block.rows %}
      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>
  {% if block.callout %}
  <div class="callout tone-{{ block.callout.tone or 'info' }}" style="margin-top: 5mm;">
    {% if block.callout.label %}<span class="callout-label">{{ block.callout.label }}:</span> {% endif %}{{ block.callout.body }}
  </div>
  {% endif %}
</section>

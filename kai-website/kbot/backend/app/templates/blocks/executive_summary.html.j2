<section class="block-card">
  <div class="block-title">{{ block.title or 'Executive Summary' }}</div>
  <div class="exec-grid{% if not block.gauge %} no-gauge{% endif %}">
    <div class="exec-narrative">
      {{ block.body_html | safe }}
      {% if block.badges %}
      <div class="exec-badges">
        {% for b in block.badges %}
        <span class="pill variant-{{ b.variant or 'neutral' }}{% if b.variant == 'warning' %} icon-warn{% endif %}{% if b.variant == 'alert' %} icon-alert{% endif %}">{{ b.label }}</span>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% if block.gauge %}
    <div class="exec-gauge">
      {% set value = block.gauge.value | int %}
      {% set max = block.gauge.max | int or 100 %}
      {% set pct = (value / max * 100) | round(0, 'common') %}
      <svg viewBox="0 0 100 60">
        <defs>
          <linearGradient id="gaugeGrad" x1="0" x2="1">
            <stop offset="0%" stop-color="#DC2626"/>
            <stop offset="50%" stop-color="#CA8A04"/>
            <stop offset="100%" stop-color="#16A34A"/>
          </linearGradient>
        </defs>
        <path d="M 10 55 A 40 40 0 0 1 90 55" stroke="#E2E8F0" stroke-width="10" fill="none" stroke-linecap="round"/>
        {# Filled arc: arc length ≈ 125.66 for radius 40 over 180°. Scale by pct/100. #}
        <path d="M 10 55 A 40 40 0 0 1 90 55"
              stroke="url(#gaugeGrad)" stroke-width="10" fill="none" stroke-linecap="round"
              stroke-dasharray="{{ (pct * 1.2566) | round(2) }} 200"/>
      </svg>
      <div class="gauge-value">
        <div class="num">{{ value }}</div>
        <div class="lbl">{{ block.gauge.label or ('/ ' ~ max) }}</div>
      </div>
    </div>
    {% endif %}
  </div>
</section>

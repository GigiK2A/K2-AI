<section class="block-card">
  <div class="block-title">{{ block.title }}</div>
  {% if block.intro %}<div class="block-intro">{{ block.intro }}</div>{% endif %}
  <div class="kpi-grid{% if block['items']|length >= 5 %} cols-3{% endif %}">
    {% for item in block['items'] %}
    <div class="kpi-card variant-{{ item.variant or 'neutral' }}">
      <div class="kpi-label">{{ item.label }}</div>
      <div class="kpi-value">{{ item.value }}</div>
      {% if item.subtitle %}<div class="kpi-subtitle">{{ item.subtitle }}</div>{% endif %}
      {% if item.hint %}<div class="kpi-hint">{{ item.hint }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="block-card">
  <div class="block-title">{{ block.title }}</div>
  <div class="risk-mitigation-grid">
    <div>
      <div class="col-heading">Rischi Principali</div>
      <div class="risk-list">
        {% for r in block.risks %}
        {% set v = 'alert' if r.severity == 'alta' else ('warning' if r.severity == 'media' else 'neutral') %}
        <div class="risk-row">
          <span class="pill variant-{{ v }}{% if v == 'warning' %} icon-warn{% endif %}{% if v == 'alert' %} icon-alert{% endif %}">{{ r.severity | capitalize }}</span>
          <div class="risk-content">
            <div class="risk-title">{{ r.title }}</div>
            <div class="risk-body">{{ r.body }}</div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    <div>
      <div class="col-heading">Strategie di Mitigazione</div>
      <div class="mitigation-list">
        {% for m in block.mitigations %}
        <div class="mitigation-card">
          <div class="mit-heading">{{ m.title }}</div>
          <div class="mit-body">{{ m.body }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

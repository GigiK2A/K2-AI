<section class="block-card">
  <div class="block-title">{{ block.title }}</div>
  <div class="two-col">
    <div>
      {% if block.left.heading %}<div class="col-heading">{{ block.left.heading }}</div>{% endif %}
      {% if block.left.body_html %}<div class="col-body">{{ block.left.body_html | safe }}</div>{% endif %}
      {% if block.left.table %}
      <table class="inline-table col-table">
        <thead><tr>{% for c in block.left.table.columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
          {% for row in block.left.table.rows %}
          <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
    <div>
      {% if block.right.heading %}<div class="col-heading">{{ block.right.heading }}</div>{% endif %}
      {% if block.right.body_html %}<div class="col-body">{{ block.right.body_html | safe }}</div>{% endif %}
      {% if block.right.badges %}
      <div class="col-badges">
        {% for b in block.right.badges %}
        <div class="col-badge-row">
          <span class="pill variant-{{ b.variant or 'neutral' }}{% if b.variant == 'warning' %} icon-warn{% endif %}{% if b.variant == 'alert' %} icon-alert{% endif %}">{{ b.label }}</span>
          <span class="desc">{{ b.description }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if block.right.callout %}
      <div class="callout tone-{{ block.right.callout.tone or 'info' }}">
        {% if block.right.callout.label %}<span class="callout-label">{{ block.right.callout.label }}:</span> {% endif %}{{ block.right.callout.body }}
      </div>
      {% endif %}
    </div>
  </div>
</section>

# ── LLM ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-6
DEFAULT_OPENAI_MODEL=gpt-4o
DEFAULT_OPENAI_MINI_MODEL=gpt-4o-mini
TAVILY_API_KEY=tvly-...

# ── Supabase ─────────────────────────
# ATTENZIONE — naming chiavi:
#   SUPABASE_KEY              → chiave PUBBLICA / publishable / anon (sb_publishable_...). Safe per frontend.
#   SUPABASE_SERVICE_KEY      → chiave SERVICE ROLE (sb_secret_...). NON deve mai finire in client/JS.
#   NEXT_PUBLIC_SUPABASE_ANON_KEY → DEVE essere la stessa chiave publishable/anon, MAI la service key.
#   NEXT_PUBLIC_* viene incluso nel bundle JS di Next.js; mettere lì una service key = leak totale del DB.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ── Telegram ─────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://board.tuodominio.it/webhook
# Obbligatorio se TELEGRAM_MODE=webhook. Stringa random ≥ 32 byte (secrets.token_urlsafe(32)).
# Viene passata a setWebhook e validata in ingresso tramite header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ── Board auth ───────────────────────
BOARD_AUTH_ENABLED=true
BOARD_USERNAME=admin
BOARD_PASSWORD=scegli-una-password-lunga
BOARD_AUTH_REALM=AI Board
BOARD_SESSION_HOURS=12

# ── Dati — Notion ────────────────────
BOARD_DATA_BACKEND=notion
NOTION_TOKEN=secret_...
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_VERSION=2022-06-28

# ── App ──────────────────────────────
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=INFO
APP_ALLOWED_ORIGINS=https://tuodominio.it,https://www.tuodominio.it,https://board.tuodominio.it

# ── Email conferma contatti ──────────
# Opzione A — Resend (consigliato, gratuito 3k/mese): resend.com
RESEND_API_KEY=re_...
EMAIL_FROM=K2-AI <noreply@tuodominio.it>
EMAIL_REPLY_TO=info@tuodominio.it
# Opzione B — SMTP
SMTP_HOST=smtp.tuoprovider.it
SMTP_PORT=587
SMTP_USER=noreply@tuodominio.it
SMTP_PASSWORD=...
SMTP_TLS=true

# ── Scheduler (cron) ─────────────────
SCHEDULER_WEEKLY_PLAN_CRON=0 8 * * 1
SCHEDULER_DAILY_BRIEF_CRON=0 8 * * *
SCHEDULER_KPI_UPDATE_CRON=0 18 * * *

# ── Monitoring & alerting ────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_ENV=production
APP_RELEASE=ai-board@local
LOG_FORMAT=json
LOG_LEVEL=info

# K2-AI AIOS — variabili d'ambiente.
# Copia in `.env` e riempi. Tutto è env-gated: senza una chiave il relativo
# sensore/connettore degrada a vuoto, la piattaforma gira lo stesso.
# "L'unica cosa che manca per il full sono le credenziali."

# --- CORE (obbligatori per girare) ---
AIOS_SUPABASE_URL=
AIOS_SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=              # ora serve SOLO alla web search (llm_web); il resto può girare in locale

# --- Backend LLM (locale vs Claude) ---
# 'anthropic' (default) = tutto su API Claude, comportamento invariato.
# 'local' = workhorse + strong su Ollama (GB10 sempre acceso). La web search resta SEMPRE su Claude.
AIOS_LLM_BACKEND=anthropic
OLLAMA_BASE_URL=http://localhost:11434   # in prod via Tailscale: http://<ip-100.x-del-GB10>:11434
AIOS_LOCAL_MODEL=gpt-oss:120b            # es. anche qwen3:32b per il bake-off
AIOS_LOCAL_THINK=medium                  # reasoning gpt-oss: low|medium|high (MAI false: svuota l'output)
AIOS_LOCAL_NUM_PREDICT=8192              # budget token in uscita (largo: headroom per il reasoning)
AIOS_LOCAL_NUM_CTX=16384                 # finestra di contesto

# --- Rete verso l'Ollama del GB10 ---
# Opzione Tailscale (privata, scelta): il container Railway entra nella tailnet.
TS_AUTHKEY=                              # auth key Tailscale (tskey-auth-…) — SOLO env Railway, mai nel repo
TS_HOSTNAME=k2-board                     # nome del container nella tailnet
AIOS_LOCAL_PROXY=http://localhost:1055   # proxy userspace di Tailscale (solo per raggiungere Ollama)
# Opzione Cloudflare Tunnel (alternativa): niente proxy, header service-token Access
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=

# --- Sicurezza API (in produzione OBBLIGATORIO) ---
AIOS_API_TOKEN=
AIOS_ALLOWED_ORIGIN=https://app.k2-ai.it

# --- Instagram (Marketing · già usato) ---
AIOS_IG_TOKEN=
AIOS_IG_USER_ID=

# --- Telegram (controllo bidirezionale) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Finance ---
STRIPE_API_KEY=                 # restricted key READ-ONLY (charges/balance read)

# --- Marketing ---
RESEND_API_KEY=
GSC_SERVICE_ACCOUNT_JSON=       # path al json del service account, o json inline
GSC_SITE_URL=https://www.k2-ai.it/
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_KEY=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
COMPETITOR_URLS=                # csv di url competitor, es: https://a.it,https://b.it

# --- Vendite ---
IMAP_HOST=                      # es: imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=                  # app password (non la password account)
GOOGLE_SA_JSON=                 # service account json per Google Calendar
GCAL_CALENDAR_ID=primary

# --- n8n (braccio esecutore per azioni ESTERNE: pubblicare post, ecc.) ---
# Senza N8N_WEBHOOK_URL le azioni esterne restano "non configurate" (nessun side-effect).
N8N_WEBHOOK_URL=                 # es: https://n8n.tuodominio.it/webhook/k2ai
N8N_WEBHOOK_TOKEN=               # opzionale: inviato come header X-AIOS-Token (firma)
# Gestione workflow (l'AI può LEGGERE e, su tua conferma, MODIFICARE i workflow):
N8N_API_URL=                     # es: https://n8n.tuodominio.it/api/v1
N8N_API_KEY=                     # n8n → Settings → n8n API → Create API Key

# Connessione Postgres diretta — serve SOLO per le modifiche di SCHEMA (DDL) approvate.
# Senza, le proposte di schema degradano a task con l'SQL pronto. Es. Supabase:
# postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
AIOS_DB_DSN=

# K2-Board — unified single-container env.
# Backend (FastAPI) + Frontend (Next.js) run in the same Railway service.

# ===== Backend (FastAPI) =====
SUPABASE_URL=https://uiuvwzrmrdqbfajguuab.supabase.co
SUPABASE_SERVICE_KEY=
BOARD_USERNAME=luigi
# bcrypt hash — python -c "import bcrypt; print(bcrypt.hashpw(b'PW', bcrypt.gensalt()).decode())"
BOARD_PASSWORD_HASH=
# 48+ random bytes — python -c "import secrets; print(secrets.token_urlsafe(48))"
BOARD_SESSION_SECRET=
BOARD_CORS_ORIGINS=https://board.k2-ai.it,http://localhost:3000
ANTHROPIC_API_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
LOG_FORMAT=json
ENVIRONMENT=production

# Google Calendar (Sprint 9+, leave empty for now)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ===== Frontend (Next.js) =====
# Leave empty in single-container prod — the browser uses relative URLs
# proxied through Next.js rewrites to internal FastAPI.
NEXT_PUBLIC_API_BASE_URL=

# PostHog (server-side only, never NEXT_PUBLIC_*)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=179781
POSTHOG_HOST=https://eu.i.posthog.com

# ===== Container =====
# Railway injects PORT automatically; default 3000 for local Docker runs.
# INTERNAL_API_URL defaults to http://127.0.0.1:8000 inside the container.
PORT=3000

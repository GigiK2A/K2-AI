    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "ricevuto_workflow", "value": "={{ $json.body.workflow }}", "type": "string" },
            { "id": "a2", "name": "ricevuto_payload", "value": "={{ JSON.stringify($json.body.payload) }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Leggi richiesta K2-AI",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.body.workflow }}", "rightValue": "send_email", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "È send_email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [600, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "c2", "leftValue": "={{ $json.body.payload.reply_to_message_id }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } }
          ]
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
